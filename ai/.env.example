# RoadIQ AI Service – Environment Variables
# Copy this file to .env before starting the AI service:
#   cp .env.example .env

# ── Mock mode ─────────────────────────────────────────────────────────────────
# Set to "false" when a trained YOLO model is available.
# When "true", the service returns clearly-labelled synthetic detections.
AI_MOCK_MODE=true

# ── Model path ────────────────────────────────────────────────────────────────
# Path to the YOLO .pt model file (relative to ai/ directory).
# Only used when AI_MOCK_MODE=false.
# Example for YOLOv8n: AI_MODEL_PATH=models/yolov8n.pt
# Example for custom:  AI_MODEL_PATH=models/roadiq_yolo.pt
AI_MODEL_PATH=models/roadiq_yolo.pt

# ── Confidence threshold ──────────────────────────────────────────────────────
# Minimum YOLO confidence score to include a detection.
AI_CONF_THRESHOLD=0.35

# ── Service port ──────────────────────────────────────────────────────────────
AI_PORT=8001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origins allowed to call this service (comma-separated).
AI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
