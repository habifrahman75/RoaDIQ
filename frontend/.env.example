# RoadIQ Frontend Environment Variables
# Copy this file to .env:
#   cp .env.example .env   (Mac/Linux)
#   copy .env.example .env  (Windows)

# ── Backend API URL ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Mock Mode ─────────────────────────────────────────────────────────────────
# "true"  → All API calls use local mock data (no backend needed)
# "false" → All API calls go to VITE_API_BASE_URL (real backend required)
#
# Set to "false" for the hackathon demo to show real data flow.
VITE_USE_MOCK=false
